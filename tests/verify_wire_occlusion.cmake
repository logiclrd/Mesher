# M56: guard precisely the real Vulkan shader + depth pipeline against
# accidental reintroduction of clip-space pull-through (rear wire leaks).
if(NOT DEFINED MESHER_SOURCE_ROOT)
    message(FATAL_ERROR "MESHER_SOURCE_ROOT must be specified")
endif()
file(READ "${MESHER_SOURCE_ROOT}/shaders/wire.vert" wire)
file(READ "${MESHER_SOURCE_ROOT}/src/viewport.cpp" viewport)
string(FIND "${wire}" "constants.viewProjection*vec4(position,1.0)" originalDepth)
string(FIND "${wire}" "constants.viewProjection*vec4(otherEndpoint,1.0)" endpointDepth)
if(originalDepth EQUAL -1 OR endpointDepth EQUAL -1)
    message(FATAL_ERROR "M56 wire shader no longer uses the identical source vertex projection as solid shader")
endif()
string(REGEX MATCH "gl_Position[ 	]*[.][ 	]*z[ 	]*[-+*/]?=" offsetDepth "${wire}")
if(offsetDepth)
    message(FATAL_ERROR "M56 wire shader applies a projected clip-depth bias: hidden surfaces can leak through solid")
endif()
string(FIND "${viewport}" "depth.depthTestEnable=hudOverlay?VK_FALSE:VK_TRUE;" depthTest)
string(FIND "${viewport}" "depth.depthWriteEnable=(wire||hudOverlay)?VK_FALSE:VK_TRUE;" depthWrite)
string(FIND "${viewport}" "depth.depthCompareOp=VK_COMPARE_OP_LESS_OR_EQUAL;" depthComparison)
if(depthTest EQUAL -1 OR depthWrite EQUAL -1 OR depthComparison EQUAL -1)
    message(FATAL_ERROR "M56 Vulkan solid/wire order requires solid depth writes and depth-tested no-write LEQUAL wire")
endif()
string(FIND "${viewport}" "constants.wireRaster[3]=wireVisible_?1.0f:0.0f;" wireToggle)
string(FIND "${viewport}" "if(wireVisible_&&floorVisible_) {" gridToggle)
if(wireToggle EQUAL -1 OR gridToggle EQUAL -1)
    message(FATAL_ERROR "M56 W solid-only diagnostic must gate both surface-attached mesh ink and floor wire pass")
endif()
message(STATUS "M56 exact clip-depth/no-depth-write wire and solid-only view contract verified")
