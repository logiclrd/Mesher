# M64 historical shader remains an analytic counterexample; it is NOT
# compiled or used by the current renderer after M69.
if(NOT DEFINED MESHER_SOURCE_ROOT)
    message(FATAL_ERROR "M64 source root required")
endif()
file(READ "${MESHER_SOURCE_ROOT}/shaders/wire.vert" historic)
file(READ "${MESHER_SOURCE_ROOT}/shaders/mesh.frag" active)
file(READ "${MESHER_SOURCE_ROOT}/CMakeLists.txt" cmake)
file(READ "${MESHER_SOURCE_ROOT}/src/partition_render.cpp" partitions)
foreach(needle "projected.xy+=perpendicular" "gl_Position=projected;")
    string(FIND "${historic}" "${needle}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "M64 analytic historical flat-depth sample missing")
    endif()
endforeach()
string(FIND "${cmake}" "set(SHADERS mesh.vert mesh.frag hud.vert hud.frag)" shaderList)
string(FIND "${active}" "abs(edgeBarycentric)/perPixel" mesh)
string(FIND "${active}" "nearest=abs(worldPosition.xy-round(worldPosition.xy));" grid)
if(shaderList EQUAL -1 OR mesh EQUAL -1 OR grid EQUAL -1)
    message(FATAL_ERROR "M64 M67/M68 depth-owner shader cutover incomplete")
endif()
foreach(needle "out.solid.push_back(vertex(a-renderOrigin,normal,colorOf(t[0])));"
               "out.solid.push_back(vertex(b-renderOrigin,normal,colorOf(t[1])));"
               "out.solid.push_back(vertex(c-renderOrigin,normal,colorOf(t[2])));")
    string(FIND "${partitions}" "${needle}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "M64 immutable source triangle triples changed")
    endif()
endforeach()
message(STATUS "M64 flat-depth analytic baseline retired from actual GPU pipeline")
