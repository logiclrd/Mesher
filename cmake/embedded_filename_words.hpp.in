#pragma once

#include <string_view>

// Generated at CMake configure time, directly from curated source word lists.
// Never ship these .txt files adjacent to Mesher's executable.
namespace mesher::embedded_filename_words {
inline constexpr std::string_view adjectives =
    R"MSHRADJ(@MESHER_FILENAME_ADJECTIVES@)MSHRADJ";
inline constexpr std::string_view nouns =
    R"MSHRNOUN(@MESHER_FILENAME_NOUNS@)MSHRNOUN";
} // namespace mesher::embedded_filename_words
